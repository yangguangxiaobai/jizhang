# A13 release signing — USER-LOCAL, NEVER COMMIT.
# Copy to `keystore.properties` next to this example (same dir, gitignored) and fill in.
# Or export the JIZHANG_* env vars instead (CI / one-off builds).
#
# Generate once (keep the file + its backup OUT of git):
#   keytool -genkeypair -v -keystore jizhang-release.jks -alias jizhang -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile: path relative to clients/android/ (e.g. jizhang-release.jks), or absolute.
storeFile=jizhang-release.jks
storePassword=CHANGE_ME
keyAlias=jizhang
keyPassword=CHANGE_ME
