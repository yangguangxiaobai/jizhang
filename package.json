{
  "name": "jizhang",
  "version": "0.1.0",
  "private": true,
  "description": "Jizhang native clients and API workspace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jizhang/shared build && pnpm -r --parallel --filter @jizhang/shared --filter @jizhang/server run dev",
    "build": "pnpm --filter @jizhang/server... build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
