# ── dependencies / build output ───────────────────────────────────────────────
node_modules/
dist/
coverage/
*.tsbuildinfo

# ── runtime data (SQLite lives on a volume in Docker; ./data for local runs) ──
data/

# A SQLite database is user data, never source. This also catches the snapshot files
# `cli.js verify` and `cli.js backup` are pointed at during a drill: one was created
# in packages/server/ while investigating a bug, and without this rule it would have
# been committed with real ledger rows in it.
*.db
*.db-wal
*.db-shm

# ── secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── local scratch ────────────────────────────────────────────────────────────
.tmp-*/

# Python cutout service caches and local environments
packages/cutout/**/__pycache__/
packages/cutout/**/.pytest_cache/
packages/cutout/**/.venv/

# ── local source-snapshot archives ───────────────────────────────────────────
# Full source tarballs kept on disk as rollback points before a deploy. Several are
# ~94 MB, right at GitHub's 100 MB hard per-file limit, and ~660 MB in total, so they
# stay local.
jizhang-*.tar
jizhang-*.tar.gz

# clients preview screenshots (local review only, A11)
/clients/docs/preview/

# ── native build products (rebuilt via CLI; signatures stay user-local) ──
*.hap
*.hsp
*.apk

# Native caches, SDK paths and local signing material are machine-specific.
clients/android/.gradle/
clients/android/**/build/
clients/android/local.properties
clients/android/keystore.properties
*.jks
*.keystore
clients/harmony/oh_modules/
clients/harmony/.hvigor/
clients/harmony/**/build/

# Generated delivery bundles; source tooling remains under deploy/.
/artifacts/
deploy/__pycache__/
