# ─────────────────────────────────────────────────────────────────────────────
# jizhang environment — copy to .env and adjust:  cp .env.example .env
#
# `.env` is gitignored. Docker Compose passes it into the container via
# `env_file`; local `pnpm dev` runs read it through Node's process.loadEnvFile().
#
# Vars marked REQUIRED have no default on purpose: the server validates the
# whole set at startup and exits 1 with an explicit list of problems instead of
# silently falling back (see packages/server/src/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Port the Fastify server binds inside the container. Compose maps it to
# 127.0.0.1:8081 on the host only.
PORT=8081
# Bind address. 0.0.0.0 is required inside a container (the host reverse proxy
# connects from outside the container network namespace).
HOST=0.0.0.0
# Trust X-Forwarded-* / X-Real-IP sent by the host Nginx/Caddy. Keep true behind
# the reverse proxy so client IPs and protocol are logged correctly.
TRUST_PROXY=true

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory holding jizhang.db. In Docker, compose forces /data (the mounted
# volume); the default below is what a local `pnpm dev` run should use.
DATA_DIR=./data
# Directory of the built web assets served at /. Defaults to
# packages/web/dist locally; the image sets /app/public. Only override if you
# lay the build output out differently.
# WEB_DIST_DIR=/app/public

# ── Runtime tuning (1 vCPU / 1 GB VPS) ───────────────────────────────────────
# Cap the V8 old-space heap so the container cannot trigger the host OOM killer.
# The Dockerfile bakes the same value in, so it usually needs no override.
# NODE_OPTIONS=--max-old-space-size=256
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Auth (REQUIRED — no defaults) ────────────────────────────────────────────
# Single-user login name (parent task design.md §7.3, D7).
JIZHANG_USERNAME=admin
# argon2id hash of the login password. Never put the plaintext password here.
# T3 ships the generator:
#   docker compose exec jizhang node packages/server/dist/cli.js set-password
# Until then this development placeholder is enough to boot the skeleton.
JIZHANG_PASSWORD_HASH=dev-placeholder-replace-with-argon2id-hash
# Session lifetime in days.
SESSION_TTL_DAYS=30
