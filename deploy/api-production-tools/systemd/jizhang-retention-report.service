[Unit]
Description=Read-only enrolled Jizhang backup retention report
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/jizhang-production/retention.py preview
# Reports contain only paths/reasons/bytes/hashes, never database content.
StandardOutput=journal
StandardError=journal
