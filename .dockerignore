# Keep the Docker build context small and deterministic: never ship the host's
# node_modules / build output / secrets into the image (the Dockerfile installs
# and builds from source inside the build).
node_modules
**/node_modules
**/dist
**/.venv
**/.pytest_cache
**/__pycache__
**/*.tsbuildinfo
*.pt
data
**/*.db
**/*.db-wal
**/*.db-shm
coverage
.tmp-*
.git
.gitignore
.dockerignore
.env
.env.*
.trellis
.agents
.dsh
.vscode
.idea
.tmp-*
**/.tmp-*
clients
packages/web
**/build
**/*.jks
**/*.keystore
**/keystore.properties
**/local.properties
*.log
*.tar
*.tar.gz
